# Databricks AI/GenAI Development

## Overview
This rule covers generative AI development on Databricks, including LLM integration, RAG systems with Vector Search, Agent Bricks automation, prompt engineering, LLM fine-tuning, and responsible AI practices.

## Core Principles

1. **Foundation Model API**: Use Databricks Foundation Model API or Model Serving for LLM inference
2. **Vector Search for RAG**: Implement RAG with Databricks Vector Search and Delta Sync
3. **Agent Bricks Automation**: Leverage Agent Bricks for common AI use cases
4. **Prompt Management**: Version control and log all prompts with inference requests
5. **Guardrails & Safety**: Implement input validation, output filtering, and PII detection

## Patterns & Best Practices

### LLM Integration with Foundation Model API

**Basic LLM Invocation:**
```python
import mlflow.deployments

# Initialize client
client = mlflow.deployments.get_deploy_client("databricks")

# Query Foundation Model API
response = client.predict(
    endpoint="databricks-llama-2-70b-chat",
    inputs={
        "messages": [
            {"role": "system", "content": "You are a helpful assistant."},
            {"role": "user", "content": "What are the key principles of RAG systems?"}
        ],
        "temperature": 0.7,
        "max_tokens": 500
    }
)

print(response['choices'][0]['message']['content'])
```

**Using External Model Serving:**
```python
from databricks.sdk import WorkspaceClient
from databricks.sdk.service.serving import ChatMessage, ChatMessageRole

w = WorkspaceClient()

# Query custom deployed model
response = w.serving_endpoints.query(
    name="my-llm-endpoint",
    messages=[
        ChatMessage(role=ChatMessageRole.SYSTEM, content="You are an AI assistant."),
        ChatMessage(role=ChatMessageRole.USER, content="Explain vector databases.")
    ],
    temperature=0.7,
    max_tokens=300
)

print(response.choices[0].message.content)
```

**Batch LLM Processing:**
```python
from pyspark.sql.functions import pandas_udf, col
import pandas as pd

# Define UDF for batch LLM inference
@pandas_udf("string")
def generate_summaries(texts: pd.Series) -> pd.Series:
    client = mlflow.deployments.get_deploy_client("databricks")
    
    summaries = []
    for text in texts:
        response = client.predict(
            endpoint="databricks-llama-2-70b-chat",
            inputs={
                "messages": [
                    {"role": "system", "content": "Summarize the following text concisely."},
                    {"role": "user", "content": text}
                ],
                "max_tokens": 100
            }
        )
        summaries.append(response['choices'][0]['message']['content'])
    
    return pd.Series(summaries)

# Apply to DataFrame
df = spark.table("catalog.schema.documents")
df_with_summaries = df.withColumn("summary", generate_summaries(col("text")))
df_with_summaries.write.saveAsTable("catalog.schema.documents_summarized")
```

### RAG Systems with Vector Search

**Create Vector Search Index:**
```python
from databricks.vector_search.client import VectorSearchClient

vsc = VectorSearchClient()

# Create endpoint (one-time setup)
vsc.create_endpoint(
    name="my_vector_search_endpoint",
    endpoint_type="STANDARD"
)

# Create Delta Sync index (auto-syncs with source table)
vsc.create_delta_sync_index(
    endpoint_name="my_vector_search_endpoint",
    source_table_name="catalog.schema.knowledge_base",
    index_name="catalog.schema.knowledge_base_index",
    pipeline_type="TRIGGERED",  # or "CONTINUOUS"
    primary_key="doc_id",
    embedding_source_column="text",  # Text column to embed
    embedding_model_endpoint_name="databricks-bge-large-en"  # Embedding model
)
```

**Query Vector Search:**
```python
# Get index
index = vsc.get_index(
    endpoint_name="my_vector_search_endpoint",
    index_name="catalog.schema.knowledge_base_index"
)

# Similarity search
results = index.similarity_search(
    query_text="What is Delta Lake?",
    columns=["doc_id", "text", "metadata"],
    num_results=5
)

# Access results
for doc in results['result']['data_array']:
    print(f"Doc ID: {doc['doc_id']}")
    print(f"Text: {doc['text']}")
    print(f"Score: {doc['score']}")
    print("---")
```

**RAG Query Pattern:**
```python
import mlflow.deployments

def rag_query(question: str, index_name: str, num_results: int = 3):
    # 1. Retrieve relevant documents
    vsc = VectorSearchClient()
    index = vsc.get_index(index_name=index_name)
    
    search_results = index.similarity_search(
        query_text=question,
        columns=["text", "source_doc"],
        num_results=num_results
    )
    
    # 2. Construct context from retrieved docs
    context = "\n\n".join([
        f"Source: {doc['source_doc']}\n{doc['text']}"
        for doc in search_results['result']['data_array']
    ])
    
    # 3. Generate answer with LLM
    client = mlflow.deployments.get_deploy_client("databricks")
    
    prompt = f"""Use the following context to answer the question. 
If the answer is not in the context, say "I don't have enough information to answer."

Context:
{context}

Question: {question}

Answer:"""
    
    response = client.predict(
        endpoint="databricks-llama-2-70b-chat",
        inputs={
            "messages": [
                {"role": "user", "content": prompt}
            ],
            "temperature": 0.1,
            "max_tokens": 300
        }
    )
    
    return {
        "answer": response['choices'][0]['message']['content'],
        "sources": [doc['source_doc'] for doc in search_results['result']['data_array']]
    }

# Use RAG
result = rag_query("What are the ACID properties of Delta Lake?", "catalog.schema.delta_docs_index")
print(f"Answer: {result['answer']}")
print(f"Sources: {result['sources']}")
```

