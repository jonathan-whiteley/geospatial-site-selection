### Guardrails & Safety

**Input Validation:**
```python
import re

def validate_input(user_input: str) -> tuple[bool, str]:
    """Validate user input for safety"""
    
    # Check length
    if len(user_input) > 10000:
        return False, "Input too long"
    
    # Check for prompt injection patterns
    injection_patterns = [
        r"ignore previous instructions",
        r"disregard all prior",
        r"system:\s*you are now",
        r"<\|im_start\|>",
    ]
    
    for pattern in injection_patterns:
        if re.search(pattern, user_input, re.IGNORECASE):
            return False, "Potential prompt injection detected"
    
    # Check for PII (basic patterns)
    pii_patterns = [
        r"\b\d{3}-\d{2}-\d{4}\b",  # SSN
        r"\b\d{16}\b",  # Credit card
        r"\b[A-Z]{2}\d{6}\b",  # Passport
    ]
    
    for pattern in pii_patterns:
        if re.search(pattern, user_input):
            return False, "PII detected in input"
    
    return True, "Valid"

# Use before LLM call
is_valid, message = validate_input(user_query)
if not is_valid:
    raise ValueError(f"Invalid input: {message}")
```

**Output Filtering:**
```python
def filter_output(llm_response: str) -> str:
    """Filter LLM output for sensitive content"""
    
    # Mask PII in output
    import re
    
    # Mask SSN
    llm_response = re.sub(r'\b\d{3}-\d{2}-\d{4}\b', 'XXX-XX-XXXX', llm_response)
    
    # Mask credit cards
    llm_response = re.sub(r'\b\d{16}\b', 'XXXX-XXXX-XXXX-XXXX', llm_response)
    
    # Remove sensitive keywords if present
    sensitive_keywords = ["password", "api_key", "secret"]
    for keyword in sensitive_keywords:
        if keyword in llm_response.lower():
            llm_response = llm_response.replace(keyword, "[REDACTED]")
    
    return llm_response
```

**LLM Evaluation:**
```python
import mlflow

# Log LLM evaluation metrics
with mlflow.start_run():
    # Evaluate with MLflow
    eval_data = pd.DataFrame({
        "inputs": [q1, q2, q3],
        "ground_truth": [a1, a2, a3]
    })
    
    results = mlflow.evaluate(
        model="models:/catalog.schema.rag_model@champion",
        data=eval_data,
        targets="ground_truth",
        model_type="question-answering",
        evaluators=["default"]  # Uses metrics like relevance, faithfulness
    )
    
    print(f"Relevance: {results.metrics['relevance']}")
    print(f"Faithfulness: {results.metrics['faithfulness']}")
```

