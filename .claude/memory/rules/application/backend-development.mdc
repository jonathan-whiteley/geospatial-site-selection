# Backend Development

## Overview
This rule covers backend development patterns for Databricks Apps, including FastAPI application structure, async operations, Databricks SDK integration, database connections, API design, and static file serving.

## Core Principles

1. **FastAPI First**: Use FastAPI for REST APIs with automatic OpenAPI documentation
2. **Async by Default**: Leverage async/await for I/O operations (database, HTTP, file operations)
3. **Databricks SDK Integration**: Use Databricks SDK for workspace operations and Unity Catalog access
4. **Type Safety**: Use Pydantic models for request/response validation
5. **Static File Serving**: Serve built frontend assets via FastAPI StaticFiles

## Patterns & Best Practices

### FastAPI Application Structure

**Project Layout:**
```
backend/
├── app.py                      # Main FastAPI application
├── config.py                   # Configuration management
├── database/
│   ├── __init__.py
│   ├── connection.py          # Database connection setup
│   └── models.py              # SQLAlchemy or Pydantic models
├── routers/
│   ├── __init__.py
│   ├── api.py                 # API route handlers
│   └── health.py              # Health check endpoints
├── services/
│   ├── __init__.py
│   └── databricks_service.py  # Business logic
├── utils/
│   ├── __init__.py
│   └── auth.py                # Authentication helpers
├── static/                    # Built frontend assets (from npm build)
└── requirements.txt           # Python dependencies
```

**Main Application (app.py):**
```python
from fastapi import FastAPI
from fastapi.staticfiles import StaticFiles
from fastapi.middleware.cors import CORSMiddleware
import os

# Import routers
from routers import api, health

# Create FastAPI app
app = FastAPI(
    title="Databricks App API",
    description="Backend API for Databricks application",
    version="1.0.0"
)

# CORS configuration (adjust for production)
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],  # Restrict in production
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# API routes (under /api prefix to avoid SPA conflicts)
app.include_router(health.router, prefix="/api/health", tags=["health"])
app.include_router(api.router, prefix="/api", tags=["api"])

# Serve static frontend files (must be last)
# Frontend handles routing, API handles /api/* routes
app.mount("/", StaticFiles(directory="static", html=True), name="static")

@app.on_event("startup")
async def startup_event():
    """Initialize resources on startup"""
    print("Application starting...")
    # Initialize database connections, caches, etc.

@app.on_event("shutdown")
async def shutdown_event():
    """Cleanup resources on shutdown"""
    print("Application shutting down...")
    # Close database connections, cleanup, etc.
```

### Async Patterns

**Async Database Operations:**
```python
from typing import List, Optional
from sqlalchemy.ext.asyncio import create_async_engine, AsyncSession
from sqlalchemy.orm import sessionmaker
from sqlalchemy import select
from pydantic import BaseModel

# Async engine setup
DATABASE_URL = "postgresql+asyncpg://user:password@host:port/database"
engine = create_async_engine(DATABASE_URL, echo=True)
async_session_maker = sessionmaker(engine, class_=AsyncSession, expire_on_commit=False)

# Pydantic models for validation
class UserCreate(BaseModel):
    name: str
    email: str

class User(BaseModel):
    id: int
    name: str
    email: str
    
    class Config:
        from_attributes = True

# Async database operations
async def get_users() -> List[User]:
    """Fetch all users asynchronously"""
    async with async_session_maker() as session:
        result = await session.execute(select(UserModel))
        users = result.scalars().all()
        return [User.from_orm(user) for user in users]

async def create_user(user_data: UserCreate) -> User:
    """Create user asynchronously"""
    async with async_session_maker() as session:
        user = UserModel(**user_data.dict())
        session.add(user)
        await session.commit()
        await session.refresh(user)
        return User.from_orm(user)

# FastAPI endpoint using async
from fastapi import APIRouter, HTTPException

router = APIRouter()

@router.get("/users", response_model=List[User])
async def list_users():
    """List all users"""
    try:
        users = await get_users()
        return users
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.post("/users", response_model=User, status_code=201)
async def create_user_endpoint(user: UserCreate):
    """Create new user"""
    try:
        new_user = await create_user(user)
        return new_user
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
```

**Async HTTP Requests:**
```python
import httpx
from typing import Dict, Any

async def fetch_external_data(url: str) -> Dict[Any, Any]:
    """Fetch data from external API asynchronously"""
    async with httpx.AsyncClient(timeout=30.0) as client:
        response = await client.get(url)
        response.raise_for_status()
        return response.json()

# Use in endpoint
@router.get("/external-data")
async def get_external_data():
    """Fetch and return external data"""
    try:
        data = await fetch_external_data("https://api.example.com/data")
        return {"data": data}
    except httpx.HTTPError as e:
        raise HTTPException(status_code=502, detail=f"External API error: {str(e)}")
```

### Databricks SDK Integration

**WorkspaceClient Setup:**
```python
from databricks.sdk import WorkspaceClient
from databricks.sdk.core import Config
import os

# Initialize Databricks client
def get_databricks_client() -> WorkspaceClient:
    """Create authenticated Databricks client"""
    # Authentication via environment variables or config
    # DATABRICKS_HOST and DATABRICKS_TOKEN should be set
    return WorkspaceClient(
        host=os.getenv("DATABRICKS_HOST"),
        token=os.getenv("DATABRICKS_TOKEN")
    )

# Dependency injection for FastAPI
from fastapi import Depends

async def get_workspace_client() -> WorkspaceClient:
    """Dependency to inject Databricks client"""
    return get_databricks_client()
```

**Unity Catalog Operations:**
```python
from databricks.sdk import WorkspaceClient
from fastapi import APIRouter, Depends, HTTPException
from pydantic import BaseModel
from typing import List

router = APIRouter()

class Table(BaseModel):
    catalog: str
    schema: str
    name: str
    table_type: str

@router.get("/catalogs", response_model=List[str])
async def list_catalogs(w: WorkspaceClient = Depends(get_workspace_client)):
    """List all Unity Catalog catalogs"""
    try:
        catalogs = list(w.catalogs.list())
        return [c.name for c in catalogs]
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.get("/tables/{catalog}/{schema}", response_model=List[Table])
async def list_tables(
    catalog: str,
    schema: str,
    w: WorkspaceClient = Depends(get_workspace_client)
):
    """List tables in a Unity Catalog schema"""
    try:
        tables = list(w.tables.list(catalog_name=catalog, schema_name=schema))
        return [
            Table(
                catalog=t.catalog_name,
                schema=t.schema_name,
                name=t.name,
                table_type=t.table_type.value
            )
            for t in tables
        ]
    except Exception as e:
        raise HTTPException(status_code=404, detail=str(e))
```

**Databricks SQL Execution:**
```python
from databricks.sdk import WorkspaceClient
from databricks.sdk.service.sql import StatementState
import time

async def execute_sql_query(w: WorkspaceClient, warehouse_id: str, query: str) -> List[Dict]:
    """Execute SQL query on Databricks SQL warehouse"""
    # Create statement
    statement = w.statement_execution.execute_statement(
        warehouse_id=warehouse_id,
        statement=query,
        wait_timeout="30s"
    )
    
    # Poll for completion
    while statement.status.state in [StatementState.PENDING, StatementState.RUNNING]:
        time.sleep(1)
        statement = w.statement_execution.get_statement(statement.statement_id)
    
    if statement.status.state == StatementState.SUCCEEDED:
        # Parse results
        result_data = statement.result.data_array
        columns = [col.name for col in statement.manifest.schema.columns]
        
        return [dict(zip(columns, row)) for row in result_data]
    else:
        raise Exception(f"Query failed: {statement.status.error}")

# Use in endpoint
@router.post("/query")
async def run_query(
    query: str,
    warehouse_id: str,
    w: WorkspaceClient = Depends(get_workspace_client)
):
    """Execute SQL query and return results"""
    try:
        results = await execute_sql_query(w, warehouse_id, query)
        return {"results": results}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
```

### Configuration Management

**Environment-Based Configuration:**
```python
from pydantic_settings import BaseSettings
from functools import lru_cache

class Settings(BaseSettings):
    """Application settings with environment variable support"""
    
    # App settings
    app_name: str = "Databricks App"
    debug: bool = False
    
    # Databricks settings
    databricks_host: str
    databricks_token: str
    
    # Database settings
    database_url: str
    
    # CORS settings
    cors_origins: List[str] = ["*"]
    
    # Feature flags
    enable_analytics: bool = True
    
    class Config:
        env_file = ".env"
        case_sensitive = False

@lru_cache()
def get_settings() -> Settings:
    """Cached settings instance"""
    return Settings()

# Use in application
from fastapi import Depends

@router.get("/config")
async def get_config(settings: Settings = Depends(get_settings)):
    """Get application configuration (non-sensitive)"""
    return {
        "app_name": settings.app_name,
        "debug": settings.debug,
        "enable_analytics": settings.enable_analytics
    }
```

### API Design Best Practices

**Consistent Error Handling:**
```python
from fastapi import HTTPException, Request
from fastapi.responses import JSONResponse
from fastapi.exceptions import RequestValidationError

class APIError(Exception):
    """Custom API error"""
    def __init__(self, status_code: int, detail: str):
        self.status_code = status_code
        self.detail = detail

@app.exception_handler(APIError)
async def api_error_handler(request: Request, exc: APIError):
    """Handle custom API errors"""
    return JSONResponse(
        status_code=exc.status_code,
        content={"error": exc.detail, "path": str(request.url)}
    )

@app.exception_handler(RequestValidationError)
async def validation_error_handler(request: Request, exc: RequestValidationError):
    """Handle validation errors"""
    return JSONResponse(
        status_code=422,
        content={"error": "Validation error", "details": exc.errors()}
    )

@app.exception_handler(Exception)
async def general_error_handler(request: Request, exc: Exception):
    """Handle uncaught exceptions"""
    return JSONResponse(
        status_code=500,
        content={"error": "Internal server error", "detail": str(exc)}
    )
```

**Request/Response Models:**
```python
from pydantic import BaseModel, Field, validator
from typing import Optional, List
from datetime import datetime

class QueryRequest(BaseModel):
    """Request model for SQL query"""
    query: str = Field(..., min_length=1, max_length=10000)
    warehouse_id: str = Field(..., regex=r"^[a-f0-9-]+$")
    timeout: Optional[int] = Field(30, ge=1, le=300)
    
    @validator('query')
    def validate_query(cls, v):
        # Basic SQL injection prevention
        dangerous_keywords = ['DROP', 'DELETE', 'TRUNCATE', 'ALTER']
        if any(keyword in v.upper() for keyword in dangerous_keywords):
            raise ValueError('Query contains dangerous keywords')
        return v

class QueryResponse(BaseModel):
    """Response model for SQL query"""
    results: List[Dict[str, Any]]
    row_count: int
    execution_time_ms: int
    timestamp: datetime = Field(default_factory=datetime.utcnow)

@router.post("/query", response_model=QueryResponse)
async def execute_query(request: QueryRequest):
    """Execute SQL query with validation"""
    start_time = time.time()
    results = await execute_sql_query(w, request.warehouse_id, request.query)
    execution_time = int((time.time() - start_time) * 1000)
    
    return QueryResponse(
        results=results,
        row_count=len(results),
        execution_time_ms=execution_time
    )
```

### Static File Serving

**Serving Built Frontend:**
```python
from fastapi import FastAPI
from fastapi.staticfiles import StaticFiles
from pathlib import Path

app = FastAPI()

# Ensure static directory exists
static_dir = Path(__file__).parent / "static"
if not static_dir.exists():
    raise RuntimeError("Static directory not found. Run 'npm run build:prod' first.")

# API routes first (higher priority)
app.include_router(api_router, prefix="/api")

# Static files last (catch-all for SPA routing)
app.mount("/", StaticFiles(directory=str(static_dir), html=True), name="static")

# Health check (before static mount if needed separately)
@app.get("/api/health")
async def health_check():
    """Health check endpoint"""
    return {"status": "healthy", "timestamp": datetime.utcnow().isoformat()}
```

### Testing

**Async Test Setup:**
```python
import pytest
from httpx import AsyncClient
from app import app

@pytest.mark.asyncio
async def test_list_users():
    """Test user listing endpoint"""
    async with AsyncClient(app=app, base_url="http://test") as client:
        response = await client.get("/api/users")
        assert response.status_code == 200
        assert isinstance(response.json(), list)

@pytest.mark.asyncio
async def test_create_user():
    """Test user creation endpoint"""
    async with AsyncClient(app=app, base_url="http://test") as client:
        user_data = {"name": "Test User", "email": "test@example.com"}
        response = await client.post("/api/users", json=user_data)
        assert response.status_code == 201
        assert response.json()["name"] == "Test User"

# Test with mocked Databricks client
from unittest.mock import Mock, AsyncMock

@pytest.mark.asyncio
async def test_list_catalogs(monkeypatch):
    """Test catalog listing with mocked client"""
    mock_client = Mock()
    mock_client.catalogs.list = Mock(return_value=[
        Mock(name="catalog1"),
        Mock(name="catalog2")
    ])
    
    async with AsyncClient(app=app, base_url="http://test") as client:
        # Override dependency
        app.dependency_overrides[get_workspace_client] = lambda: mock_client
        
        response = await client.get("/api/catalogs")
        assert response.status_code == 200
        assert "catalog1" in response.json()
```

