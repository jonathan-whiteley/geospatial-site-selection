### React TypeScript Components

**Functional Component with Props:**
```typescript
// types/index.ts
export interface User {
  id: string;
  name: string;
  email: string;
  role: 'admin' | 'user' | 'viewer';
}

export interface TableData {
  catalog: string;
  schema: string;
  name: string;
  table_type: string;
}

// components/UserCard.tsx
import React from 'react';

interface UserCardProps {
  user: User;
  onEdit?: (user: User) => void;
  onDelete?: (userId: string) => void;
  isLoading?: boolean;
}

export const UserCard: React.FC<UserCardProps> = ({
  user,
  onEdit,
  onDelete,
  isLoading = false
}) => {
  const handleEdit = () => {
    if (onEdit) {
      onEdit(user);
    }
  };

  const handleDelete = () => {
    if (onDelete && window.confirm(`Delete user ${user.name}?`)) {
      onDelete(user.id);
    }
  };

  return (
    <div className="user-card">
      <h3>{user.name}</h3>
      <p>{user.email}</p>
      <span className={`role-badge role-${user.role}`}>{user.role}</span>
      
      {!isLoading && (
        <div className="actions">
          {onEdit && (
            <button onClick={handleEdit} className="btn-edit">
              Edit
            </button>
          )}
          {onDelete && (
            <button onClick={handleDelete} className="btn-delete">
              Delete
            </button>
          )}
        </div>
      )}
      
      {isLoading && <div className="loading-spinner">Loading...</div>}
    </div>
  );
};
```

**Custom Hooks:**
```typescript
// hooks/useData.ts
import { useState, useEffect } from 'react';
import { fetchTables } from '../services/api';
import type { TableData } from '../types';

interface UseDataResult {
  data: TableData[];
  loading: boolean;
  error: Error | null;
  refetch: () => void;
}

export const useData = (catalog: string, schema: string): UseDataResult => {
  const [data, setData] = useState<TableData[]>([]);
  const [loading, setLoading] = useState<boolean>(true);
  const [error, setError] = useState<Error | null>(null);

  const fetchData = async () => {
    try {
      setLoading(true);
      setError(null);
      const tables = await fetchTables(catalog, schema);
      setData(tables);
    } catch (err) {
      setError(err instanceof Error ? err : new Error('Unknown error'));
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
  }, [catalog, schema]);

  return { data, loading, error, refetch: fetchData };
};

// Usage in component
import { useData } from '../hooks/useData';

const TablesPage: React.FC = () => {
  const { data, loading, error, refetch } = useData('main', 'default');

  if (loading) return <div>Loading...</div>;
  if (error) return <div>Error: {error.message}</div>;

  return (
    <div>
      <button onClick={refetch}>Refresh</button>
      {data.map(table => (
        <div key={`${table.catalog}.${table.schema}.${table.name}`}>
          {table.name}
        </div>
      ))}
    </div>
  );
};
```

### State Management with Zustand

**Global Store:**
```typescript
// store/appStore.ts
import { create } from 'zustand';
import { persist } from 'zustand/middleware';
import type { User } from '../types';

interface AppState {
  currentUser: User | null;
  theme: 'light' | 'dark';
  sidebarOpen: boolean;
  
  // Actions
  setCurrentUser: (user: User | null) => void;
  setTheme: (theme: 'light' | 'dark') => void;
  toggleSidebar: () => void;
}

export const useAppStore = create<AppState>()(
  persist(
    (set) => ({
      currentUser: null,
      theme: 'light',
      sidebarOpen: true,
      
      setCurrentUser: (user) => set({ currentUser: user }),
      setTheme: (theme) => set({ theme }),
      toggleSidebar: () => set((state) => ({ sidebarOpen: !state.sidebarOpen })),
    }),
    {
      name: 'app-storage', // localStorage key
      partialize: (state) => ({ theme: state.theme }), // Only persist theme
    }
  )
);

// Usage in component
import { useAppStore } from '../store/appStore';

const Header: React.FC = () => {
  const { currentUser, theme, setTheme, toggleSidebar } = useAppStore();

  return (
    <header className={`header ${theme}`}>
      <button onClick={toggleSidebar}>Toggle Sidebar</button>
      <button onClick={() => setTheme(theme === 'light' ? 'dark' : 'light')}>
        Switch to {theme === 'light' ? 'Dark' : 'Light'} Mode
      </button>
      {currentUser && <span>Welcome, {currentUser.name}</span>}
    </header>
  );
};
```

### API Integration

**Service Layer:**
```typescript
// services/api.ts
import type { User, TableData } from '../types';

const API_BASE_URL = '/api'; // Proxied to backend

class APIError extends Error {
  constructor(public status: number, message: string) {
    super(message);
    this.name = 'APIError';
  }
}

async function fetchAPI<T>(endpoint: string, options?: RequestInit): Promise<T> {
  try {
    const response = await fetch(`${API_BASE_URL}${endpoint}`, {
      headers: {
        'Content-Type': 'application/json',
        ...options?.headers,
      },
      ...options,
    });

    if (!response.ok) {
      const errorData = await response.json().catch(() => ({}));
      throw new APIError(
        response.status,
        errorData.error || `HTTP ${response.status}`
      );
    }

    return await response.json();
  } catch (error) {
    if (error instanceof APIError) throw error;
    throw new Error(`Network error: ${error instanceof Error ? error.message : 'Unknown'}`);
  }
}

// API functions
export const fetchUsers = (): Promise<User[]> => {
  return fetchAPI<User[]>('/users');
};

export const createUser = (userData: Omit<User, 'id'>): Promise<User> => {
  return fetchAPI<User>('/users', {
    method: 'POST',
    body: JSON.stringify(userData),
  });
};

export const fetchTables = (catalog: string, schema: string): Promise<TableData[]> => {
  return fetchAPI<TableData[]>(`/tables/${catalog}/${schema}`);
};

export const executeQuery = (query: string, warehouseId: string): Promise<any> => {
  return fetchAPI('/query', {
    method: 'POST',
    body: JSON.stringify({ query, warehouse_id: warehouseId }),
  });
};

// Usage with error handling
import { fetchUsers } from '../services/api';

const UsersPage: React.FC = () => {
  const [users, setUsers] = useState<User[]>([]);
  const [error, setError] = useState<string | null>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const loadUsers = async () => {
      try {
        const data = await fetchUsers();
        setUsers(data);
      } catch (err) {
        if (err instanceof APIError) {
          setError(`API Error ${err.status}: ${err.message}`);
        } else {
          setError(err instanceof Error ? err.message : 'Unknown error');
        }
      } finally {
        setLoading(false);
      }
    };

    loadUsers();
  }, []);

  return (
    <div>
      {loading && <p>Loading users...</p>}
      {error && <div className="error">{error}</div>}
      {!loading && !error && users.map(user => (
        <UserCard key={user.id} user={user} />
      ))}
    </div>
  );
};
```

### Styling Patterns

**CSS Modules:**
```typescript
// components/Button.module.css
.button {
  padding: 0.5rem 1rem;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-weight: 500;
  transition: all 0.2s;
}

.button.primary {
  background-color: #0066cc;
  color: white;
}

.button.secondary {
  background-color: #6c757d;
  color: white;
}

.button:hover {
  opacity: 0.9;
  transform: translateY(-1px);
}

.button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

// components/Button.tsx
import styles from './Button.module.css';

interface ButtonProps {
  variant?: 'primary' | 'secondary';
  disabled?: boolean;
  children: React.ReactNode;
  onClick?: () => void;
}

export const Button: React.FC<ButtonProps> = ({
  variant = 'primary',
  disabled = false,
  children,
  onClick
}) => {
  return (
    <button
      className={`${styles.button} ${styles[variant]}`}
      disabled={disabled}
      onClick={onClick}
    >
      {children}
    </button>
  );
};
```

